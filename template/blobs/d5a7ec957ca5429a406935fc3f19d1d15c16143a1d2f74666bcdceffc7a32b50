schema_version: 1
default_profile: fast
max_concurrency: 4
profiles:
  fast:
    always_groups: [hygiene]
  candidate:
    always_groups: [hygiene, candidate-integrity]
  release:
    all_groups: true
core_escalation_patterns:
  - AGENTS.md
  - yss-project.yaml
  - docs/process/maintenance-intensity.yaml
  - docs/process/lifecycle-registry.yaml
  - scripts/verify-template
  - scripts/verify-template-fast
  - scripts/verify-template-candidate
  - scripts/run-template-verification
  - scripts/lib/template-verification.mjs
  - scripts/verify-template-verification-scenarios
  - .template-source/tooling/node/scripts/design-md.mjs
  - docs/process/template-verification-profiles.yaml
required_files:
  - yss-project.yaml
  - AGENTS.md
  - CONTEXT.md
  - skills-lock.json
  - docs/agents/yss-skill-registry.yaml
  - docs/agents/digital-human-roles.yaml
  - docs/process/lifecycle-registry.yaml
  - docs/process/lifecycle-registry-baseline.json
  - docs/process/maintenance-intensity.yaml
  - docs/process/harness-profile.yaml
  - docs/process/instance-distribution-manifest.yaml
  - docs/process/template-verification-profiles.yaml
  - docs/process/schemas/digital-human-task-package.schema.json
  - docs/process/schemas/subagent-task-package.schema.json
  - docs/process/schemas/strategic-design-handoff.schema.json
  - docs/process/schemas/context-reconciliation.schema.json
  - docs/process/templates/lifecycle-checkpoint-template.yaml
  - docs/process/templates/context-reconciliation-template.yaml
  - docs/design/schemas/visual-baseline.schema.json
  - docs/design/templates/visual-baseline-template.yaml
  - docs/templates/subagent-task-package-template.md
  - docs/templates/strategic-design-handoff-template.yaml
  - .agents/skills/yss-strategic-design/SKILL.md
  - .agents/skills/yss-strategic-design/agents/openai.yaml
  - .agents/skills/yss-strategic-design/references/orchestration-contract.yaml
  - .agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs
  - scripts/repository-mode
  - scripts/sync-skills
  - scripts/update-skill-lock
  - scripts/generate-lifecycle-artifacts
  - scripts/verify-lifecycle-registry
  - scripts/verify-lifecycle-checkpoint
  - scripts/lib/context-contract.mjs
  - scripts/verify-context-contract
  - scripts/verify-context-contract-scenarios
  - scripts/verify-business-language-scenarios
  - scripts/verify-context-reconciliation
  - scripts/verify-context-reconciliation-scenarios
  - scripts/verify-grill-with-docs-context-scenarios
  - scripts/verify-strategic-design-handoff
  - scripts/verify-strategic-design-handoff-scenarios
  - scripts/verify-harness-profile
  - scripts/verify-harness-profile-scenarios
  - scripts/verify-entry-alignment
  - scripts/verify-instance-distribution
  - scripts/verify-instance-distribution-scenarios
  - scripts/lib/harness-profile.mjs
  - scripts/lib/entry-alignment.mjs
  - scripts/lib/instance-distribution.mjs
  - scripts/lib/task-package.mjs
  - scripts/lib/template-verification.mjs
  - scripts/verify-digital-human-task-package
  - scripts/verify-digital-human-task-package-scenarios
  - scripts/verify-subagent-task-package
  - scripts/verify-subagent-task-package-scenarios
  - scripts/verify-lifecycle-transition-scenarios
  - scripts/verify-maintenance-checkpoint
  - scripts/verify-maintenance-intensity-scenarios
  - scripts/verify-skill-registry
  - scripts/verify-skill-governance
  - scripts/verify-digital-human-roles
  - scripts/verify-digital-human-roles-scenarios
  - scripts/verify-approval-record
  - scripts/export-yss-skills
  - scripts/run-template-verification
  - scripts/verify-template-fast
  - scripts/verify-template-candidate
  - scripts/verify-template
  - scripts/verify-template-verification-scenarios
syntax_files:
  - scripts/verify-business-language-scenarios
  - scripts/sync-skills
  - scripts/update-skill-lock
  - scripts/generate-lifecycle-artifacts
  - scripts/verify-lifecycle-registry
  - scripts/verify-harness-profile
  - scripts/verify-harness-profile-scenarios
  - scripts/verify-entry-alignment
  - scripts/verify-instance-distribution
  - scripts/verify-instance-distribution-scenarios
  - scripts/lib/harness-profile.mjs
  - scripts/lib/entry-alignment.mjs
  - scripts/lib/instance-distribution.mjs
  - scripts/lib/task-package.mjs
  - scripts/verify-digital-human-task-package
  - scripts/verify-digital-human-task-package-scenarios
  - scripts/verify-subagent-task-package
  - scripts/verify-subagent-task-package-scenarios
  - scripts/verify-maintenance-checkpoint
  - scripts/verify-maintenance-intensity-scenarios
  - scripts/verify-skill-registry
  - scripts/verify-skill-governance
  - scripts/verify-digital-human-roles
  - scripts/verify-digital-human-roles-scenarios
  - scripts/verify-approval-record
  - scripts/lib/lifecycle-transition.mjs
  - scripts/verify-lifecycle-scenarios
  - scripts/verify-lifecycle-transition-scenarios
  - scripts/export-yss-skills
  - scripts/lib/template-verification.mjs
  - scripts/run-template-verification
  - scripts/verify-template-verification-scenarios
routing:
  - patterns: ["scripts/*strategic-handoff*", "scripts/*strategic-feedback*", "scripts/lib/strategic-handoff*", "scripts/lib/strategic-feedback*", "scripts/fixtures/strategic-handoff/**", ".template-source/distribution/strategic-handoff-tools.lock.json", "docs/process/strategic-handoff-package.md", "docs/process/schemas/strategic-handoff-*", "docs/process/schemas/strategic-design-handoff-*", "docs/process/schemas/strategic-*feedback*"]
    groups: [strategic-handoff-package]
  - patterns: [AGENTS.md, CONTEXT.md, yss-project.yaml, package.json, .gitignore, README.md, "docs/**"]
    groups: [hygiene]
  - patterns: [skills-lock.json, ".agents/skills/**", ".claude/skills/**", ".codex/skills/**", ".cursor/skills/**", ".pi/skills/**", ".qoder/skills/**", ".trae/skills/**", "docs/agents/yss-skill-registry.yaml", "scripts/*skill*"]
    groups: [skills]
  - patterns: [".agents/skills/yss-strategic-design/**", "docs/process/schemas/strategic-design-handoff.schema.json", "docs/templates/strategic-design-handoff-template.yaml", "scripts/*entry-alignment*"]
    groups: [strategic-design]
  - patterns: ["docs/process/maintenance-*", "docs/process/harness-process-tailoring.md", "scripts/*maintenance*", "scripts/lib/maintenance-*"]
    groups: [maintenance]
  - patterns: ["docs/process/lifecycle-*", "docs/process/templates/lifecycle-*", "scripts/*lifecycle*", "scripts/lib/lifecycle-*"]
    groups: [lifecycle]
  - patterns: ["docs/agents/digital-human-*", "docs/process/schemas/*task-package*", "docs/templates/subagent-task-package-template.md", "scripts/*task-package*", "scripts/*digital-human*", "scripts/lib/task-package*"]
    groups: [collaboration, workspace-fixtures]
  - patterns: ["docs/process/harness-profile.yaml", "docs/process/instance-distribution-manifest.yaml", "scripts/*harness-profile*", "scripts/*instance-distribution*", "scripts/lib/harness-profile.mjs", "scripts/lib/instance-distribution.mjs"]
    groups: [profile, workspace-fixtures]
  - patterns: [".template-source/**", "scripts/vendor/**"]
    groups: [tooling]
  - patterns: ["DESIGN.md", "docs/design/**", ".template-source/tooling/node/scripts/design-md.mjs", ".template-source/tooling/node/test/design-md.test.mjs"]
    groups: [design-system, tooling]
  - patterns: [".github/**"]
    groups: [candidate-integrity]
  - patterns: ["scripts/**"]
    groups: [hygiene]
groups:
  strategic-handoff-package:
    commands:
      - { run: "scripts/verify-strategic-handoff-tools-lock", when: template-source }
      - { run: "node --check scripts/lib/strategic-handoff.mjs" }
      - { run: "scripts/verify-strategic-handoff-package-scenarios" }
  hygiene:
    commands: []
  tooling:
    commands:
      - { run: ".template-source/scripts/evidence-index --check", when: template-source }
      - { run: "pnpm --dir .template-source/tooling/node test", when: template-source }
      - { run: "pnpm --dir .template-source/tooling/node check:vendor", when: template-source }
  design-system:
    commands:
      - { run: "node .template-source/tooling/node/scripts/design-md.mjs lint DESIGN.md", when: template-source }
      - { run: "node .template-source/tooling/node/scripts/design-md.mjs drift", when: template-source }
  skills:
    commands:
      - { run: "scripts/sync-skills --check" }
      - { run: "scripts/update-skill-lock --check" }
      - { run: "scripts/verify-skill-registry" }
      - { run: "scripts/verify-skill-governance" }
  strategic-design:
    commands:
      - { run: "scripts/verify-strategic-design-handoff-scenarios" }
      - { run: "scripts/verify-entry-alignment" }
      - { run: "scripts/verify-lifecycle-scenarios" }
      - { run: "node .agents/skills/yss-stage-decision/tests/run-scenarios.mjs" }
      - { run: "node .agents/skills/yss-research/tests/run-scenarios.mjs" }
      - { run: "node .agents/skills/yss-prototype-stage/tests/run-scenarios.mjs" }
      - { run: "node .agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs validate docs/design/templates/visual-baseline-template.yaml --allow-template" }
      - { run: "node --test .agents/skills/yss-design-system/scripts/validate-frontmatter.test.mjs" }
      - { run: "node --test .agents/skills/yss-antd-design/scripts/validate-frontmatter.test.mjs" }
      - { run: "node .agents/skills/yss-antdv-next-design/tests/run-scenarios.mjs" }
  collaboration:
    commands:
      - { run: "scripts/verify-digital-human-roles" }
      - { run: "scripts/verify-digital-human-roles-scenarios" }
      - { run: "scripts/verify-approval-record --history docs/templates/approval-record-template.yaml" }
  lifecycle:
    commands:
      - { run: "scripts/verify-context-contract --root . --json" }
      - { run: "scripts/verify-context-contract-scenarios" }
      - { run: "node scripts/verify-business-language-scenarios" }
      - { run: "scripts/verify-context-reconciliation-scenarios" }
      - { run: "scripts/verify-grill-with-docs-context-scenarios" }
      - { run: "scripts/verify-lifecycle-registry" }
      - { run: "scripts/verify-lifecycle-checkpoint docs/process/templates/lifecycle-checkpoint-template.yaml" }
      - { run: "scripts/verify-lifecycle-transition-scenarios" }
      - { run: "node scripts/verify-plan-spec-entry-scenarios" }
  profile:
    commands:
      - { run: "node scripts/verify-strategic-checkpoint-scenarios" }
      - { run: "node scripts/verify-strategic-user-decision-scenarios" }
      - { run: "scripts/verify-harness-profile" }
      - { run: "scripts/verify-harness-profile-scenarios" }
  workspace-fixtures:
    commands:
      - { run: "scripts/verify-subagent-task-package-scenarios" }
      - { run: "scripts/verify-digital-human-task-package-scenarios" }
      - { run: "scripts/verify-digital-human-task-package .template-source/evidence/maintenance/digital-human-task-package-review-task.yaml", when: template-source }
      - { run: "scripts/verify-digital-human-task-package .template-source/evidence/maintenance/lifecycle-ticket-transition-review-task-package.yaml", when: template-source }
      - { run: "scripts/verify-instance-distribution" }
      - { run: "scripts/verify-instance-distribution-scenarios", when: template-source }
  maintenance:
    commands:
      - { run: "scripts/verify-maintenance-intensity-scenarios" }
  candidate-integrity:
    commands:
      - { run: "scripts/verify-strategic-handoff-tools-lock --require-committed", when: template-source }
      - { run: "node scripts/verify-template-verification-scenarios" }
