#!/usr/bin/env node
import { parseArgs } from "node:util";
import { validateApprovalRecordFile } from "./lib/approval-record.mjs";

try {
  const { positionals, values } = parseArgs({ allowPositionals: true, strict: true, options: { "require-approved": {type:"boolean"}, history: {type:"boolean"} } });
  if (values.history && values["require-approved"]) throw new TypeError("--history 与 --require-approved 互斥");
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-approval-record <approval-record.yaml>");
  validateApprovalRecordFile(positionals[0], {requireApproved: !values.history});
  process.stdout.write(values.history ? "历史结构校验通过；不构成当前放行\n" : "当前会签批准校验通过\n");
} catch (error) {
  process.stderr.write(`会签记录校验失败: ${error.message}\n`);
  process.exitCode = 1;
}
