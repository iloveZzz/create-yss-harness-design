schema_version: 2
document_writing:
  supporting_skill: i-have-adhd
  condition: lifecycle-document-output
  scope: current-document-work-only
  dispatch: pass-condition-and-reference-to-document-owner
  reference: docs/process/document-writing.md
  examples: docs/templates/examples/lifecycle-writing-examples.md
  artifact_ownership: unchanged
  gate_and_status_semantics: unchanged
supported_state_schema_versions: [1]

checkpoint_policy:
  strategy: consolidated
  state_owner: yss-strategic-design
  authoritative_state: checkpoint
  navigation: map.md
  ticket_references: ticket_sync.status/refs
  historical_parent_ticket: read-only
  user_decision_validator: scripts/verify-approval-record --require-approved
  decision_policy_ref: docs/agents/digital-human-roles.yaml
  reuse_contract_ref: docs/process/strategic-handoff-package.md
  flush_on: [human_pause, handoff]
  flush_immediately_on: [blocked, responsibility_changed, asset_approval]
  preserve_stage_causality: true
  required_stage_trace_fields: [stage, upstream_refs, artifact_refs, gate_decisions, downstream_impacts]
  project_instance_stage_exit_requires_context_reconciliation: true

modes:
  route: read_only
  audit: read_only
  orchestrate: bounded_write
  resume: rebuild_then_bounded_write

profile_registry:
  ref: docs/process/harness-profile.yaml
  default_profile: harness.business-ddd-strategy-handoff
  activation: profile-aware-route
  target_user_roles: [role.product-manager, role.requirements-manager, role.business]
  control_plane_roles: [role.lifecycle-orchestrator]
  terminal_work_unit: work-unit.strategic-design-handoff
  terminal_next_route: null
  downstream_team: downstream-rd-team
  downstream_skill: yss-technical-design
  handoff_template: docs/templates/strategic-design-handoff-template.yaml
  handoff_schema: docs/process/schemas/strategic-design-handoff.schema.json
  handoff_schema_version: 2
  handoff_context_contract: {source_snapshot: required, context_delta: required, target_reconciliation_before_tactical_design: required}
  allowed_local_work_units: [work-unit.plan-opportunity, work-unit.plan-requirements, work-unit.domain-strategy-design, work-unit.stage-decision, work-unit.spec-synthesis, work-unit.prototype-design, work-unit.business-ticket-formalization, work-unit.strategic-design-handoff]
  forbidden_local_work_units: [work-unit.technical-analysis, work-unit.ticket-decomposition, work-unit.slice-implementation, work-unit.frontend-implementation-verification, work-unit.code-review, work-unit.release-and-retrospective]
  forbidden_local_artifacts: [artifact.openapi-draft, artifact.openapi-freeze-record, artifact.tactical-design, artifact.parent-ticket, artifact.vertical-slice-ticket, artifact.slice-implementation-contract]

entry_routing:
  manifest: yss-project.yaml
  valid_modes: [template-source, project-instance]
  invalid_manifest:
    action: migration-check
  direct_matt_entry:
    skill: ask-matt
    delegate_to: yss-strategic-design
    requires_valid_manifest: true
    action: navigate-only
    lifecycle_state_mutation: forbidden
    lifecycle_artifact_write: forbidden
    return_to_orchestrator: required
  formal_user_entry:
    skills: [ask-matt, grill-me, grill-with-docs, to-spec, to-tickets, triage, wayfinder]
    action: lifecycle-validate-and-accept
    lifecycle_artifact_write: conditional-explicit-user-entry
    return_to_orchestrator: required
  template_source:
    route: template-maintenance
    forbidden_artifacts: [product-spec, prototype, openapi, vertical-slice-tickets]
    forbidden_flows: [to-spec, to-tickets, release, retrospective]
    on_forbidden_flow: blocked
    block_reason: template-source-product-artifact-forbidden

matt_skill_result:
  status: compatibility-read-only
  may_influence_routing: false
  normalize_to: workflow-execution-result-v1
  schema_version: 1
  result_values: [completed, blocked, needs-human, failed]
  required: [result, skill, evidence_refs, changed_artifacts, new_impacts, stale_candidates, next_route, blocking_signals]
  blocking_signals: [drift, new_impacts, violation, missing_evidence, stale_candidates]
  completed_requires_empty: [new_impacts, stale_candidates]
  completed_requires_non_empty: [evidence_refs]
  completed_requires_readable_evidence_refs: true
  evidence_ref_validation: readable-or-resolvable
  completed_requires_no_blocking_signals: true
  router_status_mapping: {draft: completed, blocked: blocked, ready-for-lifecycle-review: needs-human}

workflow_execution_result:
  canonical_output_schema: workflow-execution-result-v1
  accepted_input_schemas: [workflow-execution-result-v1]
  legacy:
    matt-skill-result-v1:
      status: compatibility-read-only
      may_influence_routing: false
      normalize_to: workflow-execution-result-v1
      removal_target: schema_version_2
  result_values: [completed, blocked, needs-human, failed]
  required: [result_schema, work_unit, workflow_reference, result, context_reconciliation, evidence_refs, changed_artifacts, new_impacts, stale_candidates, next_route, blocking_signals]
  unavailable_skill:
    required: [skill, provider, fallback, resolution]
    blocking_result: blocked
  blocking_signals: [drift, new_impacts, violation, missing_evidence, stale_candidates]
  completed_requires_empty: [new_impacts, stale_candidates]
  completed_requires_non_empty: [evidence_refs]
  completed_requires_readable_evidence_refs: true
  evidence_ref_validation: readable-or-resolvable
  completed_requires_no_blocking_signals: true
  context_reconciliation:
    schema_ref: docs/process/schemas/context-reconciliation.schema.json
    validator: scripts/verify-context-reconciliation
    project-instance: {required_status: reconciled, readable_ref_required: true, transition_without_reconciliation: blocked}
    template-source: {required_status: not-applicable, reason_required: true}
    creates_gate: false
  workflow_reference:
    required: [source, skill, invocation_mode]
    allowed_sources: [yss-strategic-design, mattpocock/skills]
  next_route:
    validator: scripts/lib/lifecycle-transition.mjs
    function: validateNextRoute
    null_allowed_when: [blocked, needs-human, failed, terminal_completed]
  work_unit_requirements:
    work-unit.business-ticket-formalization:
      completed_requires: [business_ticket_set_ref]
    work-unit.strategic-design-handoff:
      completed_requires: [strategic_design_handoff_ref]
      handoff_validator: scripts/verify-strategic-design-handoff
      handoff_schema_version: 2

task_package:
  schema_version: 1
  applies_to: all-formal-digital-human-dispatches
  schema_ref: docs/process/schemas/digital-human-task-package.schema.json
  compatibility_schema_ref: docs/process/schemas/subagent-task-package.schema.json
  validator: scripts/verify-digital-human-task-package
  compatibility_validator: scripts/verify-subagent-task-package
  persistence_layout: docs/.scratch/<feature>/task-packages/<task-id>.yaml
  required: [schema_version, task_id, work_unit_id, actor_id, role_id, runtime_id, execution_state, workflow_status, skill_source, contract, inputs, objective, allowed_write_paths, forbidden_actions, expected_outputs, expected_evidence_files, verification_commands, verification_results, downstream_consumers, convergence]
  optional: [profile_id]
  execution_states: [Explorer, Drafter, Worker, Reviewer, Verifier]
  workflow_statuses: [not-started, active, paused, resolved, failed]
  skill_source:
    registry_ref: docs/agents/digital-human-roles.yaml
    defaults: taskPackageDefaults(role_id)
    copy_required: [core_skills, forbidden_skills]
  contract:
    kinds: [lifecycle-work-unit, template-maintenance]
    required: [kind, contract_id, contract_version, status, contract_ref]
    status_at_dispatch: issued
    status_after_change: [stale, blocked]
    lifecycle-work-unit:
      required: [lifecycle_ref]
      forbidden: [slice_contract_ref, maintenance_ref]
      template_source_work_unit: forbidden
    template-maintenance:
      required: [maintenance_ref]
      forbidden: [slice_contract_ref, lifecycle_ref]
  dispatch:
    owner: role.lifecycle-orchestrator
    mode: orchestrator-one-to-one
    per_feature_instances: forbidden
  write_isolation:
    policy: task-package-policy
    changed_files_must_be_within_allowed_paths: true
    shared_workspace_is_not_security_boundary: true
  downstream:
    formal_channel: [task_package_ref, contract_ref, evidence_refs, workflow_execution_result]
    direct_chat_is_not_formal_evidence: true
  stale:
    owner: yss-strategic-design
    on_contract_change: [mark_downstream_stale, reroute]
  compatibility:
    legacy_results: read-only-normalize
    schema_version: 1

matt_invocation_boundary:
  user_invoked_skills: [ask-matt, grill-me, grill-with-docs, handoff, to-spec, to-tickets, triage, wayfinder]
  lifecycle_managed_user_entries: [ask-matt, grill-me, grill-with-docs, to-spec, to-tickets, triage, wayfinder]
  model_invoked_skills: [code-review, competitive-intelligence, domain-modeling, grilling, prototype-review, writing-for-agents, yss-research]
  lifecycle_allowed_model_invoked_skills: [competitive-intelligence, domain-modeling, grilling, prototype-review, yss-research]
  lifecycle_may_invoke_user_invoked: false
  formal_artifact_owner: explicit-user-entry
  continuous_orchestration: compatibility-prepare-and-validate-only
  direct_user_entry: lifecycle-validate-and-accept

skill_source_contract:
  lock_version: 3
  source_revisions_required: [mattpocock/skills]
  adaptation_ref_required_when_effective_diff: true
  retired_shared_skills: [batch-grill-me, product-design-prototype, yss-dictionary, yss-jdbc, yss-log, yss-taskflow, yss-backend-scaffold-application, yss-backend-scaffold-domain, yss-backend-scaffold-infrastructure, yss-backend-scaffold-web]

lifecycle_native_entries:
  default_entry: yss-strategic-design
  formal_artifact_owner: yss-strategic-design
  user_confirmation_required_at: [spec-baseline, prototype-confirmation, strategic-design-handoff]
  compatibility_entries:
    to-spec: lifecycle-validate-and-accept
    to-tickets: lifecycle-validate-and-accept
    triage: lifecycle-validate-and-accept

work_unit_routes:
  work-unit.plan-opportunity:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-strategic-design
    supporting_skills: [competitive-intelligence, yss-research]
    skills: [competitive-intelligence, yss-research]
    route_by: {market_or_competitor_fact: competitive-intelligence, technical_or_standard_fact: yss-research:technical-evidence, strategy_fact: yss-research:strategy-evidence, no_external_fact: yss-strategic-design}
    applies_when: opportunity_or_external_fact_requires_validation
    not_applicable_reason: no_external_fact
  work-unit.plan-requirements:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-strategic-design
    supporting_skills: [grilling, domain-modeling]
    skills: [grilling, domain-modeling]
    applies_when: requirements_or_domain_boundary_unclear
    not_applicable_reason: requirements_already_confirmed
  work-unit.domain-strategy-design:
    native: {source: yss-strategic-design, skill: yss-stage-decision, invocation_mode: model-invoked}
    primary_skill: yss-stage-decision
    supporting_skills: [domain-modeling, yss-research, grilling]
    skills: [yss-stage-decision, domain-modeling, yss-research, grilling]
    research_contract: {profile: strategy-evidence, mode_before_gate: evidence-audited, artifact_owner: yss-research, downstream_owner: yss-stage-decision}
    human_gate: domain-strategy-approved
    applies_when: domain_boundary_or_language_or_core_rule_impact
    not_applicable_reason: no_domain_strategy_impact
  work-unit.stage-decision:
    native: {source: yss-strategic-design, skill: yss-stage-decision, invocation_mode: model-invoked}
    primary_skill: yss-stage-decision
    supporting_skills: [domain-modeling, yss-research]
    skills: [yss-stage-decision, domain-modeling, yss-research]
    research_contract: {profile: strategy-evidence, mode_before_gate: evidence-audited, artifact_owner: yss-research, downstream_owner: yss-stage-decision}
    human_gate: stage-decision-package-approved
    applies_when: plan_to_spec_requires_stable_decision_package
    not_applicable_reason: existing_approved_stage_decision_current
  work-unit.spec-synthesis:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-strategic-design
    supporting_skills: [domain-modeling]
    compatibility: {source: mattpocock/skills, skill: to-spec, invocation_mode: reference, formal_artifact_owner: explicit-user-entry}
    skills: [domain-modeling]
    human_gate: spec-baseline
    applies_when: new_feature_or_behavior_change
    not_applicable_reason: existing_frozen_spec_is_current
  work-unit.prototype-design:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-prototype-stage
    supporting_skills: [prototype-review, yss-design-system, yss-antdv-next-design, yss-antd-design, product-design:index]
    skills: [prototype-review, yss-design-system, yss-prototype-stage, yss-antdv-next-design, yss-antd-design, product-design:index]
    human_gate: prototype-confirmation
    applies_when: product_design_impact
    not_applicable_reason: no_ui_or_product_design_impact
  work-unit.business-ticket-formalization:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-strategic-design
    supporting_skills: []
    compatibility: {source: mattpocock/skills, skill: to-tickets, invocation_mode: reference, formal_artifact_owner: explicit-user-entry}
    skills: [yss-strategic-design]
    applies_when: approved_scope_ready_for_business_ticketing
    not_applicable_reason: business_scope_not_frozen
    next_route: work-unit.strategic-design-handoff
  work-unit.strategic-design-handoff:
    native: {source: yss-strategic-design, skill: yss-strategic-design, invocation_mode: model-invoked}
    primary_skill: yss-strategic-design
    supporting_skills: []
    skills: [yss-strategic-design]
    human_gate: strategic-design-handoff-approved
    applies_when: strategic_inputs_ready_for_downstream
    not_applicable_reason: strategic_inputs_incomplete
  work-unit.technical-analysis:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only
  work-unit.ticket-decomposition:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only
  work-unit.slice-implementation:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only
  work-unit.frontend-implementation-verification:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only
  work-unit.code-review:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only
  work-unit.release-and-retrospective:
    downstream: true
    owner: downstream-rd-team
    handoff: strategic-design-handoff
    applies_when: downstream_profile_approved
    not_applicable_reason: downstream_only

compatibility_flow_preconditions:
  to-spec:
    required: [grill_exit, no_unresolved_runnable_blocker]
    evidence: [user_problem, mvp_and_non_goals, success_criteria, test_seam, terminology_review]
    output_role: ready-for-human
  to-tickets:
    required: [required_gates_satisfied, business_scope, acceptance_criteria, dependencies_and_risks]
    output: business-level-tickets
    output_role: ready-for-human
  implement:
    status: removed
    action: blocked-and-handoff
    reason: implementation_is_owned_by_downstream_rd_profile

transition_graph:
  validator: scripts/lib/lifecycle-transition.mjs
  routes:
    work-unit.ssot-update: [work-unit.skill-projection-sync, work-unit.intensity-aware-verification]
    work-unit.skill-projection-sync: [work-unit.template-snapshot-build, work-unit.intensity-aware-verification]
    work-unit.template-snapshot-build: [work-unit.attach-sync-integration, work-unit.intensity-aware-verification]
    work-unit.attach-sync-integration: [work-unit.intensity-aware-verification]
    work-unit.intensity-aware-verification: [work-unit.intensity-aware-review]
    work-unit.intensity-aware-review: [work-unit.release-and-rollback]
    work-unit.release-and-rollback: []
    work-unit.plan-opportunity: [work-unit.plan-requirements, work-unit.domain-strategy-design, work-unit.stage-decision]
    work-unit.plan-requirements: [work-unit.domain-strategy-design, work-unit.stage-decision]
    work-unit.domain-strategy-design: [work-unit.stage-decision]
    work-unit.stage-decision: [work-unit.spec-synthesis]
    work-unit.spec-synthesis: [work-unit.prototype-design]
    work-unit.prototype-design: [work-unit.business-ticket-formalization]
    work-unit.business-ticket-formalization: [work-unit.strategic-design-handoff]
    work-unit.strategic-design-handoff: []
  forbidden_shortcuts:
    - {from: work-unit.spec-synthesis, to: work-unit.technical-analysis}
    - {from: work-unit.prototype-design, to: work-unit.slice-implementation}
    - {from: work-unit.strategic-design-handoff, to: work-unit.slice-implementation}

planning:
  entry_validator: scripts/verify-plan-spec-entry
  review_contract: docs/plan/entry-review.md
  check_policy: docs/process/lifecycle-registry.yaml
  default_check_status: pending
  formal_spec_draft_requires_passed_entry: true
  stage: stage.plan
  record: artifact.plan-record
  template: docs/plan/templates/plan-template.md
  exit_policy: docs/process/lifecycle-registry.yaml
  migration_policy: docs/process/plan-migration.md
  critical_open_questions: block-before-spec
  deferred_details_require: [noncritical_reason, owner, resolution_point, downstream_recipient]
  reuse_requires: [source_ref, current_version, applicable_scope, reason]
  downstream: work-unit.spec-synthesis
  implementation_authorized: false
  frontier_scope: current-plan-decisions
  deferred_details: excluded-from-frontier-only-after-user-confirms-deferral

grill_exit:
  required: [frontier_empty, facts_resolved_or_routed, decisions_confirmed, shared_understanding_confirmed, no_unresolved_runnable_blocker]
  facts_resolved_or_routed:
    technical_fact: yss-research
    runnable_question: handoff-prototype-handoff
    external_decision: external-input-required
  user_confirmation_required: true
  output: plan-evidence

git_authorization:
  natural_language_intent_is_authorization: false
  commit:
    requires_explicit_user_authorization: true
    required: [commit_authorized, commit_scope, commit_authorization_ref]
    authorized_value: true
    non_empty: [commit_scope, commit_authorization_ref]
    unauthorized_action: checkpoint-only
  push:
    requires_explicit_user_authorization: true
    required: [push_authorized, push_scope, push_authorization_ref]
    authorized_value: true
    non_empty: [push_scope, push_authorization_ref]
    unauthorized_action: checkpoint-only
  git_submodule:
    applies_when: repository_scope=git-submodule
    forbid_commit_on_detached_head: true
    commit_order: [submodule-repositories, superproject-gitlink]
    push_order: [submodule-repositories, superproject-gitlink]
    push_recurse_submodules: check
    empty_gitlink_scaffold: blocked
    treat_empty_gitlink_as_regular_dir: blocked
    treat_detached_head_as_regular_dir: blocked
    force_overlay_mount: blocked
    write_inside_detached_head: blocked
    require_git_entry_mode: "160000"
    working_tree_declared_scope_must_match: true
    copy_source_into_harness: forbidden
    clone_requires_recurse_submodules: true
    delivery_order_must_include: superproject-gitlink-update
    nested_authorization: per-repository
    inspect_working_tree_writable: explicit-boolean
    empty_gitlink_writable: false
    force_overlay_regular_dir_path: blocked

seam_deferred_required: [risk, owner, follow_up_ticket, verification_plan, target_version_or_release_date]

tracker:
  allowed_platforms: [local-markdown, github, gitlab]
  default_platform: local-markdown
  selection_precedence: [persisted_project_configuration, explicit_user_choice, template_default]
  remote_origin_role: code_host_only
  no_automatic_cross_platform_switch: true
  local_markdown:
    root: docs/.scratch
    legacy_roots: [.scratch, docs/requirements/tickets]
    feature_layout: [map.md, plan, spec.md, design, gates, issues, strategic-design-handoff.yaml]
    primary_sync: local
    remote_ticket_required: false
    remote_mirror: optional
  remote_platforms:
    primary_sync: remote
    remote_ticket_required: true
    unavailable_fallback_root: docs/.scratch
    unavailable_fallback_marker: pending-publication
    unavailable_fallback_record: map.md
    unavailable_fallback_fields: [tracker, publication, pending_publication_to]

setup_readiness:
  evaluation: once_per_task
  recheck_when: [tracker_changed, remote_changed, labels_changed, configuration_changed]
  missing_action: needs-human
  requested_skill: setup-matt-pocock-skills
  resume_route: setup-readiness
  preserves: [lifecycle.status, gate.status, ticket.role]
  lifecycle_may_invoke_setup: false
  legacy_artifacts_detected: {action: migration-check, setup: forbidden, write: paused}
  states: [ready, missing, conflict, degraded, not-applicable]
  evidence: [platform, label_check, domain_layout, artifact_root, migration_ref]
  semantics:
    ready: [tracker_compatible, labels_verified, domain_layout_verified, artifact_root_verified]
    missing: [required_configuration_absent, legacy_artifacts_detected_requires_migration]
    conflict: [persistent_configuration_or_tracker_conflict, canonical_and_legacy_artifacts]
    degraded: [target_platform_unavailable]
    not-applicable: [template_source_validate_only]
  template_source: {action: validate-only}

unknown_impact:
  action: pause
  reason_code: impact-classification-required

impact_propagation:
  wording:
    targets:
      - {kind: artifact, name: spec, level: direct, when: always}
      - {kind: artifact, name: strategic-design-handoff, level: transitive, when: always}
  ui-state:
    targets:
      - {kind: artifact, name: product-design, level: direct, when: ui_impact}
      - {kind: artifact, name: prototype, level: direct, when: ui_impact}
      - {kind: artifact, name: strategic-design-handoff, level: transitive, when: always}
  domain-boundary:
    targets:
      - {kind: artifact, name: domain-strategy, level: direct, when: always}
      - {kind: artifact, name: stage-decision-package, level: transitive, when: always}
      - {kind: artifact, name: spec, level: transitive, when: always}
      - {kind: artifact, name: strategic-design-handoff, level: transitive, when: always}
  business-invariant:
    targets:
      - {kind: artifact, name: domain-strategy, level: direct, when: always}
      - {kind: artifact, name: spec, level: direct, when: always}
      - {kind: artifact, name: business-ticket-set, level: transitive, when: always}
      - {kind: artifact, name: strategic-design-handoff, level: transitive, when: always}

prototype_return_evidence:
  required: [prototype_profile, source_handoff, prototype_asset_or_run, conclusion, updated_authoritative_asset, remaining_questions, return_handoff]
  allowed_profiles: [H1, H2]

phase_boundary:
  choices: [continue, clear, handoff, subagent, compact]
  precedence: [continue, clear, handoff, subagent, compact]
  invariants: [does-not-force-clear, preserves-lifecycle-state]
  evidence:
    required: [decision, reason]
    conditional:
      handoff: [source_ref, destination_ref]
      subagent: [task_package_ref, convergence_ref]
      compact: [next_phase]
  preserves: [lifecycle.status, gate.status, ticket.role]

external_input_pause:
  transition: pause
  reason_code: external-input-required
  reason: required decision-maker input is not available to the Agent
  required: [questionnaire_ref, recipient_role, requested_outputs, resume_route]
  response_required: [response_ref, reclassified_impact, updated_authoritative_asset]
  resume_requires: [response_ref, reclassified_impact, updated_authoritative_asset]

prototype_profiles:
